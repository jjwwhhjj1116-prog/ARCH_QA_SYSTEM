# Local-only development. Cloudflare/Sites values are intentionally absent.
# Production must fail closed when authenticated workspace headers are missing.
LOCAL_DEMO_MODE=true

# Production: comma-separated exact email allowlist. Do not hardcode this in source.
APP_ALLOWED_EMAILS=jy04210810@gmail.com

# Production values belong in Sites runtime settings. Never commit a real key.
# The server returns only readiness/model status and never returns this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
