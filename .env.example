# Local-only development. Cloudflare/Sites values are intentionally absent.
# Production must fail closed when authenticated workspace headers are missing.
LOCAL_DEMO_MODE=true

# Production: comma-separated exact email allowlist. Do not hardcode this in source.
APP_ALLOWED_EMAILS=admin@example.com

# Production values belong in Sites runtime settings. Never commit a real key.
# The server returns only readiness/model status and never returns this key.
GEMINI_API_KEY=
# Independent 32-byte random encryption key encoded as 64 hex characters.
# Required for personal credential persistence. Never rotate while rows exist.
AI_SETTINGS_ENCRYPTION_KEY=

# Shared memory is disabled by default. Use a server secret; never NEXT_PUBLIC_*.
MEMORY_MODE=disabled
MEM0_API_KEY=
MEM0_SHARED_AGENT_ID=concost-qc-shared-v1
GEMINI_MODEL=gemini-2.5-flash

# Disabled until the owner approves changing the Sites audience.
# Provision only server-side hashed roster chunks using the private helper output.
EMPLOYEE_LOGIN_ENABLED=false
APP_ORIGIN=
EMPLOYEE_ROSTER_1=

# Direct Cloudflare builds force employee login and Google Drive storage.
# Company OAuth client/secret are entered by an admin in Settings, not here.
FILE_STORAGE_PROVIDER=
